<?xml version="1.0" encoding="utf-8"?>
<!--
  桌面小组件布局。

  RemoteViews 只支持有限的控件与属性，这里只用 FrameLayout / LinearLayout / ImageView / TextView。

  结构：
  - 底层 ImageView：整张天气场景位图（天空渐变 + 太阳/月亮 + 云 + 雨雪雷电特效），
    由 Provider 按控件实际尺寸离屏绘制后塞进来，圆角与卡片一致；
  - 上层 LinearLayout：图标、标题、温度、天气、城市、连接状态、已接收数。

  垂直方向用空 TextView + weight 做弹性留白（RemoteViews 白名单里没有 Space，
  用 Space 会导致整张卡片加载失败）。
-->
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/widgetRoot"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/widget_bg">

    <!-- 天气场景：铺满整张卡片，fitXY 让不同尺寸的卡片都能覆盖完整 -->
    <ImageView
        android:id="@+id/widgetScene"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:importantForAccessibility="no"
        android:scaleType="fitXY" />

    <!--
      天体层：太阳/月亮单独画在正方形位图里。
      整张背景是 fitXY 铺满的，会被卡片比例拉伸，只有正圆的天体受不了拉伸，
      所以它用一个固定 dp 的正方形 ImageView 承载，任何卡片尺寸下都不会变椭圆。
    -->
    <ImageView
        android:id="@+id/widgetCelestial"
        android:layout_width="100dp"
        android:layout_height="100dp"
        android:layout_gravity="end|center_vertical"
        android:layout_marginEnd="10dp"
        android:importantForAccessibility="no"
        android:scaleType="fitCenter" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical"
        android:padding="13dp">

        <!-- 第一行：图标 + 标题 + 温度 -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <ImageView
                android:id="@+id/widgetIcon"
                android:layout_width="24dp"
                android:layout_height="24dp"
                android:contentDescription="@string/widget_title"
                android:src="@mipmap/ic_launcher_round_my" />

            <TextView
                android:id="@+id/widgetTitle"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="7dp"
                android:layout_weight="1"
                android:ellipsize="end"
                android:maxLines="1"
                android:text="@string/widget_title"
                android:textColor="#22303F"
                android:textSize="14sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/widgetTemp"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="4dp"
                android:includeFontPadding="false"
                android:maxLines="1"
                android:text="@string/widget_temp_unknown"
                android:textColor="#22303F"
                android:textSize="22sp"
                android:textStyle="bold" />
        </LinearLayout>

        <!-- 第二行：天气现象 + 城市 / 更新时间 -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="1dp"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <TextView
                android:id="@+id/widgetCondition"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:ellipsize="end"
                android:maxLines="1"
                android:text="@string/widget_weather_loading"
                android:textColor="#4E5A6C"
                android:textSize="12sp" />

            <TextView
                android:id="@+id/widgetCity"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="6dp"
                android:ellipsize="end"
                android:maxLines="1"
                android:text="@string/widget_weather_locating"
                android:textColor="#66738A"
                android:textSize="11sp" />
        </LinearLayout>

        <!-- 传输进度：只在传输中出现，桌面就能看到传到哪了 -->
        <ProgressBar
            android:id="@+id/widgetProgress"
            style="?android:attr/progressBarStyleHorizontal"
            android:layout_width="match_parent"
            android:layout_height="4dp"
            android:layout_marginTop="6dp"
            android:max="100"
            android:progress="0"
            android:progressDrawable="@drawable/bg_progress"
            android:visibility="gone" />

        <!-- 弹性留白 -->
        <TextView
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1" />

        <!-- 第三行：连接状态 + 已接收文件数。点这一行直接进「已收文件」 -->
        <LinearLayout
            android:id="@+id/widgetStatusRow"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:paddingVertical="2dp">

            <ImageView
                android:id="@+id/widgetDot"
                android:layout_width="9dp"
                android:layout_height="9dp"
                android:contentDescription="@string/widget_status_label"
                android:src="@drawable/widget_dot" />

            <TextView
                android:id="@+id/widgetStatus"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="5dp"
                android:maxLines="1"
                android:text="@string/widget_status_disconnected"
                android:textColor="#4E5A6C"
                android:textSize="12sp" />

            <!-- 敲一敲：连通后出现，点一下对方的人物会弹一下 -->
            <TextView
                android:id="@+id/widgetKnockBtn"
                android:layout_width="wrap_content"
                android:layout_height="20dp"
                android:layout_marginStart="6dp"
                android:background="@drawable/widget_btn"
                android:contentDescription="@string/widget_btn_knock_desc"
                android:gravity="center"
                android:paddingStart="7dp"
                android:paddingEnd="7dp"
                android:text="@string/widget_btn_knock_short"
                android:textColor="#3C4757"
                android:textSize="10sp"
                android:visibility="gone" />

            <TextView
                android:id="@+id/widgetReceived"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="6dp"
                android:layout_weight="1"
                android:ellipsize="end"
                android:gravity="end"
                android:maxLines="1"
                android:text="@string/widget_received_zero"
                android:textColor="#5C6879"
                android:textSize="11sp" />
        </LinearLayout>
    </LinearLayout>
</FrameLayout>
