<?xml version="1.0" encoding="utf-8"?>
<!--
  主按钮：蓝紫渐变。
  四档状态，顺序不能乱（selector 从上往下第一个命中即生效）：
  - enabled=false：去渐变改半透明深灰，文字由 @color/btn_text 一起变淡，
    否则用户看到的是一个「能按但没反应」的按钮；
  - pressed：加深并去掉描边，模拟被按下去；
  - hovered：整体变亮 + 白描边（鼠标/键盘操作时能一眼看出指向）；
  - 默认：正常渐变。
-->
<ripple xmlns:android="http://schemas.android.com/apk/res/android"
    android:color="#44FFFFFF">
    <!-- mask：把涟漪裁进 14dp 圆角里，否则扩散是矩形的，和按钮形状对不上 -->
    <item android:id="@android:id/mask">
        <shape android:shape="rectangle">
            <solid android:color="#FFFFFF" />
            <corners android:radius="14dp" />
        </shape>
    </item>
    <item>
        <selector>
            <item android:state_enabled="false">
                <shape android:shape="rectangle">
                    <solid android:color="#26FFFFFF" />
                    <stroke
                        android:width="1dp"
                        android:color="#1FFFFFFF" />
                    <corners android:radius="14dp" />
                </shape>
            </item>
            <item android:state_pressed="true">
                <shape android:shape="rectangle">
                    <gradient
                        android:angle="315"
                        android:endColor="#1E40AF"
                        android:startColor="#2563EB" />
                    <corners android:radius="14dp" />
                </shape>
            </item>
            <item android:state_hovered="true">
                <shape android:shape="rectangle">
                    <gradient
                        android:angle="315"
                        android:endColor="#6366F1"
                        android:startColor="#60A5FA" />
                    <stroke
                        android:width="1dp"
                        android:color="#CCFFFFFF" />
                    <corners android:radius="14dp" />
                </shape>
            </item>
            <item>
                <shape android:shape="rectangle">
                    <gradient
                        android:angle="315"
                        android:endColor="#4F46E5"
                        android:startColor="#3B82F6" />
                    <corners android:radius="14dp" />
                </shape>
            </item>
        </selector>
    </item>
</ripple>
