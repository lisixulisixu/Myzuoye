<?xml version="1.0" encoding="utf-8"?>
<!--
  主按钮：蓝紫渐变。
  悬停时整体变亮并加一圈白描边（鼠标操作时能一眼看出当前指向哪个按钮），
  按压时加深并去掉描边，模拟被按下去。
-->
<ripple xmlns:android="http://schemas.android.com/apk/res/android"
    android:color="#44FFFFFF">
    <item>
        <selector>
            <item android:state_pressed="true">
                <shape android:shape="rectangle">
                    <gradient
                        android:angle="315"
                        android:endColor="#1E40AF"
                        android:startColor="#2563EB" />
                    <corners android:radius="12dp" />
                </shape>
            </item>
            <item android:state_hovered="true">
                <shape android:shape="rectangle">
                    <gradient
                        android:angle="315"
                        android:endColor="#6366F1"
                        android:startColor="#60A5FA" />
                    <stroke
                        android:width="1dp"
                        android:color="#CCFFFFFF" />
                    <corners android:radius="12dp" />
                </shape>
            </item>
            <item>
                <shape android:shape="rectangle">
                    <gradient
                        android:angle="315"
                        android:endColor="#4F46E5"
                        android:startColor="#3B82F6" />
                    <corners android:radius="12dp" />
                </shape>
            </item>
        </selector>
    </item>
</ripple>
