<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.ACCESS_WIFI_STATE" />
    <uses-permission android:name="android.permission.CHANGE_WIFI_STATE" />
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />
    <!-- 桌面「敲一敲」那一下的手感；normal 权限，安装即授予 -->
    <uses-permission android:name="android.permission.VIBRATE" />
    <!-- 天气小组件只用到大致位置；不设 maxSdkVersion，Android 13+ 也需要它 -->
    <uses-permission android:name="android.permission.ACCESS_COARSE_LOCATION" />
    <uses-permission android:name="android.permission.ACCESS_FINE_LOCATION"
        android:maxSdkVersion="32" />
    <uses-permission android:name="android.permission.NEARBY_WIFI_DEVICES"
        android:usesPermissionFlags="neverForLocation"
        tools:targetApi="tiramisu" />
    <!--
      Android 16（API 36）起新增「本地网络访问」运行时权限：
      没有它，应用对局域网 / Wi-Fi Direct / 模拟器宿主等本地地址的 TCP 连接会被
      系统直接丢包（表现为「Wi-Fi Direct 组网成功、ping 通，但 TCP 一定超时」）。
      低版本系统不认识这个权限，会忽略，不影响安装。
    -->
    <uses-permission android:name="android.permission.ACCESS_LOCAL_NETWORK"
        tools:targetApi="36" />
    <!-- Android 9 及以下写公共「下载」目录需要；10 起改用 MediaStore，无需此权限 -->
    <uses-permission android:name="android.permission.WRITE_EXTERNAL_STORAGE"
        android:maxSdkVersion="28" />

    <!-- M4：前台服务（数据传输保活），Android 14+ 需声明类型 -->
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_DATA_SYNC" />
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
    <!-- 开机后复位小组件状态（否则重启后桌面还显示「已连接」） -->
    <uses-permission android:name="android.permission.RECEIVE_BOOT_COMPLETED" />

    <application
        android:allowBackup="true"
        android:dataExtractionRules="@xml/data_extraction_rules"
        android:fullBackupContent="@xml/backup_rules"
        android:icon="@mipmap/ic_launcher_round_my"
        android:label="@string/app_name"
        android:roundIcon="@mipmap/ic_launcher_round_my"
        android:supportsRtl="true"
        android:theme="@style/Theme.Myzuoye">
        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:windowSoftInputMode="adjustResize">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />

                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>

            <!-- 从相册/文件管理器「分享」直接发到本应用 -->
            <intent-filter>
                <action android:name="android.intent.action.SEND" />

                <category android:name="android.intent.category.DEFAULT" />

                <data android:mimeType="*/*" />
            </intent-filter>
            <intent-filter>
                <action android:name="android.intent.action.SEND_MULTIPLE" />

                <category android:name="android.intent.category.DEFAULT" />

                <data android:mimeType="*/*" />
            </intent-filter>

            <!-- 长按图标的快捷入口（搜索设备 / 已收文件 / 最近发送） -->
            <meta-data
                android:name="android.app.shortcuts"
                android:resource="@xml/shortcuts" />
        </activity>

        <activity
            android:name=".ReceivedFilesActivity"
            android:exported="false" />

        <!-- 导出诊断日志：把 logs/ 目录授权给分享目标 -->
        <provider
            android:name="androidx.core.content.FileProvider"
            android:authorities="${applicationId}.fileprovider"
            android:exported="false"
            android:grantUriPermissions="true">
            <meta-data
                android:name="android.support.FILE_PROVIDER_PATHS"
                android:resource="@xml/file_paths" />
        </provider>

        <service
            android:name=".service.TransferService"
            android:exported="false"
            android:foregroundServiceType="dataSync" />

        <!-- 开机复位小组件状态 -->
        <receiver
            android:name=".widget.BootReceiver"
            android:exported="false">
            <intent-filter>
                <action android:name="android.intent.action.BOOT_COMPLETED" />
            </intent-filter>
        </receiver>

        <!-- 插电 / 拔电时顺手刷新小组件（电源广播不在隐式广播限制里） -->
        <receiver
            android:name=".widget.WidgetEventReceiver"
            android:exported="false">
            <intent-filter>
                <action android:name="android.intent.action.ACTION_POWER_CONNECTED" />
                <action android:name="android.intent.action.ACTION_POWER_DISCONNECTED" />
            </intent-filter>
        </receiver>

        <!-- 通知栏「取消」：不需要跳界面，点一下就把当前传输停掉 -->
        <receiver
            android:name=".service.TransferActionReceiver"
            android:exported="false">
            <intent-filter>
                <action android:name="com.example.myzuoye.action.CANCEL_TRANSFER" />
            </intent-filter>
        </receiver>

        <!-- 桌面小组件：显示连接状态与已接收文件数，点按进入应用 -->
        <receiver
            android:name=".widget.TransferWidgetProvider"
            android:exported="false"
            android:label="@string/widget_title">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_UPDATE" />
            </intent-filter>

            <meta-data
                android:name="android.appwidget.provider"
                android:resource="@xml/widget_transfer_info" />
        </receiver>
    </application>

</manifest>
